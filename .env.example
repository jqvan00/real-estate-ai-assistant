ENVIRONMENT=development
DATABASE_URL=sqlite:///./app.db
SECRET_KEY=change-me
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# External providers used by the current app
GOOGLE_API_KEY=
CENSUS_API_KEY=
RENTCAST_API_KEY=
ZILLAPI_KEY=
ZILLAPI_BASE_URL=https://api.zillapi.com/v1
RAPIDAPI_KEY=

# Provider and cache behavior
DEMO_MODE=false
USE_RAPIDAPI=true
CENSUS_CACHE_DAYS=3650
RENTCAST_PROPERTY_CACHE_DAYS=30
RENTCAST_AVM_CACHE_DAYS=7
FEMA_CACHE_DAYS=365
GOOGLE_PLACES_CACHE_DAYS=30
